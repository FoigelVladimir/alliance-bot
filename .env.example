# Скопируйте в .env и заполните значения для локального запуска.
APP_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Enable only behind a trusted TLS proxy that replaces X-Forwarded-Proto.
DJANGO_TRUST_HTTPS_PROXY=0
DATABASE_URL=postgresql://alliance@localhost:5432/alliance
# CAS_ROOT=/absolute/path/to/private/cas

# Доступ к сообщениям сообщества ВК.
VK_GROUP_ID=
VK_ACCESS_TOKEN=

# Адрес и имя модели зависят от выбранного сервера модели.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_SHA256=

# Registered VK ID web application and its exact HTTPS callback URL.
VK_ID_CLIENT_ID=
VK_ID_REDIRECT_URI=

# Set to a fresh incident ID before starting against a restored database.
STAFF_QUARANTINE_INCIDENT=

# Enable real outgoing support messages only after VK pilot verification.
VK_SEND_ENABLED=0

# Enable history matching only after verifying VK correlation in the pilot community.
VK_HISTORY_CORRELATION_VERIFIED=0

# Enable the Long Poll reader only for the configured pilot dialog.
VK_LONG_POLL_ENABLED=0
VK_LONG_POLL_PILOT_PEER_ID=

# Enable only after verifying attachment CDN hosts on the test community.
VK_ATTACHMENT_FETCH_ENABLED=0
VK_ATTACHMENT_HOSTS=

# Enable gap backfill only after verifying conversation discovery and history on the pilot.
VK_GAP_HISTORY_VERIFIED=0

# Enable after verifying VK callback answers and their time window.
VK_CLICK_ANSWERS_VERIFIED=0

# Directory containing the verified E5 tokenizer.json and onnx/model.onnx.
KNOWLEDGE_E5_ROOT=

# Diagnostic AI lookup only. Returns messages to manual review.
SUPPORT_AI_LOOKUP_ENABLED=0
SUPPORT_AI_GENERATION_ENABLED=0
SUPPORT_AI_HANDOFF_ENABLED=0
VK_BOT_SEND_ENABLED=0
VK_BOT_RECONCILIATION_AUTO_ENABLED=0
