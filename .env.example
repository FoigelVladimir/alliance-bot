# Предварительный пример. Работающего приложения пока нет.
# После выбора стека уточните имена и обязательность переменных.
# Скопируйте в .env и заполните своими значениями.

APP_ENV=development

# Подключение к общей базе: формат зависит от выбранной СУБД.
DATABASE_URL=

# Доступ к сообщениям сообщества ВК.
VK_GROUP_ID=
VK_ACCESS_TOKEN=

# Адрес и имя модели зависят от выбранного сервера модели.
MODEL_BASE_URL=
MODEL_NAME=
